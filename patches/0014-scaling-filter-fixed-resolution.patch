diff -ruN a/client/SDL/SDL3/sdl_window.cpp b/client/SDL/SDL3/sdl_window.cpp
--- a/client/SDL/SDL3/sdl_window.cpp	2026-11-20 23:52:47
+++ b/client/SDL/SDL3/sdl_window.cpp	2026-11-20 23:52:47
@@ -31,7 +31,16 @@
 
 #define TAG "com.freerdp.client.SDL"
 
+/* LanRDP: upscaling filter selected in the app (LANRDP_FILTER=nearest). */
+static SDL_ScaleMode lanrdp_scale_mode()
+{
+	const char* filter = getenv("LANRDP_FILTER");
+	if (filter && (strcmp(filter, "nearest") == 0))
+		return SDL_SCALEMODE_NEAREST;
+	return SDL_SCALEMODE_LINEAR;
+}
 
+
 SdlWindow::SdlWindow(SDL_DisplayID id, const std::string& title, const SDL_Rect& rect,
                      [[maybe_unused]] Uint32 flags)
     : _initialW(rect.w), _initialH(rect.h), _displayID(id)
@@ -224,6 +233,19 @@
 void SdlWindow::resizeable(bool use)
 {
 	SDL_SetWindowResizable(_window, use);
+
+	/* LanRDP: fixed-resolution sessions keep their aspect ratio, so a resized
+	 * window is always filled by the locally scaled image (no letterboxing). */
+	float ratio = 0.0f;
+	if (use)
+	{
+		const char* fixed = getenv("LANRDP_FIXED_SIZE");
+		unsigned int w = 0;
+		unsigned int h = 0;
+		if (fixed && (sscanf(fixed, "%ux%u", &w, &h) == 2) && (w > 0) && (h > 0))
+			ratio = static_cast<float>(w) / static_cast<float>(h);
+	}
+	std::ignore = SDL_SetWindowAspectRatio(_window, ratio, ratio);
 	std::ignore = SDL_SyncWindow(_window);
 }
 
