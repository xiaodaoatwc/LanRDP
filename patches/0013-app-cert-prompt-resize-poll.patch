+Uint32 SDLCALL sdlDispContext::OnPoll(void* param, SDL_TimerID timerID, Uint32 interval)
+{
+	WINPR_UNUSED(timerID);
+	auto* ctx = static_cast<sdlDispContext*>(param);
+	if (!ctx || !ctx->_sdl || !ctx->_disp || !ctx->_activated)
+		return interval;
 
+	auto settings = ctx->_sdl->context()->settings;
+	if (!settings)
+		return interval;
+	if (!freerdp_settings_get_bool(settings, FreeRDP_DynamicResolutionUpdate))
+		return interval;
+
+	auto* win = ctx->_sdl->getFirstWindow();
+	if (!win)
+		return interval;
+
+	if (!ctx->_sdl->updateWindow(win->id()))
+		return interval;
+	if (!ctx->_sdl->updateWindowList())
+		return interval;
+	(void)ctx->sendResize();
+	return interval;
+}
