+static void lanrdp_write_cert_prompt(const char* path, const char* host, UINT16 port,
+                                     const char* common_name, const char* subject,
+                                     const char* issuer, const char* fingerprint,
+                                     const char* old_subject, const char* old_issuer,
+                                     const char* old_fingerprint, BOOL changed)
+{
+	if (!path || !*path)
+		return;
+	FILE* fp = fopen(path, "w");
+	if (!fp)
+		return;
+	fprintf(fp, "host=%s\n", host ? host : "");
+	fprintf(fp, "port=%u\n", port);
+	fprintf(fp, "type=%s\n", changed ? "changed" : "new");
+	fprintf(fp, "common_name=%s\n", common_name ? common_name : "");
+	fprintf(fp, "subject=%s\n", subject ? subject : "");
+	fprintf(fp, "issuer=%s\n", issuer ? issuer : "");
+	fprintf(fp, "fingerprint=%s\n", fingerprint ? fingerprint : "");
+	fprintf(fp, "old_subject=%s\n", old_subject ? old_subject : "");
+	fprintf(fp, "old_issuer=%s\n", old_issuer ? old_issuer : "");
+	fprintf(fp, "old_fingerprint=%s\n", old_fingerprint ? old_fingerprint : "");
+	fclose(fp);
+}
+
+static BOOL sdl_lang_zh(void)
