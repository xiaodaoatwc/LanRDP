+static void gdi_avc_yuv_free(rdpGdi* gdi, gdiGfxSurface* surface)
+{
+	if (!gdi || !surface)
+		return;
+	EnterCriticalSection(&gdi->avcYuvLock);
+	gdi_avc_yuv_free_locked(surface);
+	LeaveCriticalSection(&gdi->avcYuvLock);
+}
+
+static BOOL gdi_avc_yuv_capture_locked(rdpGdi* gdi, gdiGfxSurface* surface,
+                                const RDPGFX_H264_METABLOCK* meta,
+                                const RDPGFX_AVC420_BITMAP_STREAM* bs)
+{
+	WINPR_ASSERT(gdi);
+	WINPR_ASSERT(surface);
+	WINPR_ASSERT(meta);
+	WINPR_ASSERT(bs);
+
+	const BYTE* planes[3] = { 0 };
+	UINT32 strides[3] = { 0 };
+	UINT32 w = 0;
+	UINT32 h = 0;
+	if (h264_get_decoded_yuv(surface->h264, planes, strides, &w, &h) < 0)
+		return FALSE;
+	if ((w == 0) || (h == 0) || (w > surface->width) || (h > surface->height))
+		return FALSE;
+
+	const UINT32 cw = (w + 1) / 2;
+	const UINT32 ch = (h + 1) / 2;
+	const UINT32 yStride = strides[0];
+	const UINT32 uStride = strides[1];
+	const UINT32 vStride = strides[2];
+
+	if (!surface->avcYuvPlanes[0])
+	{
+		surface->avcYuvPlanes[0] = malloc((size_t)w * h);
+		surface->avcYuvPlanes[1] = malloc((size_t)cw * ch);
+		surface->avcYuvPlanes[2] = malloc((size_t)cw * ch);
+		if (!surface->avcYuvPlanes[0] || !surface->avcYuvPlanes[1] ||
+		    !surface->avcYuvPlanes[2])
+		{
+			gdi_avc_yuv_free(gdi, surface);
+			return FALSE;
+		}
+	}
+
+	for (UINT32 y = 0; y < h; y++)
+		memcpy(surface->avcYuvPlanes[0] + (size_t)y * w,
+		       planes[0] + (size_t)y * yStride, w);
+	for (UINT32 y = 0; y < ch; y++)
+	{
+		memcpy(surface->avcYuvPlanes[1] + (size_t)y * cw,
+		       planes[1] + (size_t)y * uStride, cw);
+		memcpy(surface->avcYuvPlanes[2] + (size_t)y * cw,
+		       planes[2] + (size_t)y * vStride, cw);
+	}
+
+	UINT32 left = UINT32_MAX;
+	UINT32 top = UINT32_MAX;
+	UINT32 right = 0;
+	UINT32 bottom = 0;
+	for (UINT32 i = 0; i < meta->numRegionRects; i++)
+	{
+		const RECTANGLE_16* r = &meta->regionRects[i];
+		left = (r->left < left) ? r->left : left;
+		top = (r->top < top) ? r->top : top;
+		right = (r->right > right) ? r->right : right;
+		bottom = (r->bottom > bottom) ? r->bottom : bottom;
+	}
+	if (right <= left || bottom <= top)
+	{
+		left = 0;
+		top = 0;
+		right = w;
+		bottom = h;
+	}
+
+	BYTE* lastData = nullptr;
+	RECTANGLE_16* lastRects = nullptr;
+	if (bs->data && (bs->length > 0) && (meta->numRegionRects > 0))
+	{
+		lastData = malloc(bs->length);
+		lastRects = calloc(meta->numRegionRects, sizeof(RECTANGLE_16));
+		if (!lastData || !lastRects)
+		{
+			free(lastData);
+			free(lastRects);
+			return FALSE;
+		}
+		memcpy(lastData, bs->data, bs->length);
+		memcpy(lastRects, meta->regionRects, meta->numRegionRects * sizeof(RECTANGLE_16));
+	}
+
+	free(surface->avcLastData);
+	free(surface->avcLastRects);
+	surface->avcLastData = lastData;
+	surface->avcLastSize = lastData ? bs->length : 0;
+	surface->avcLastRects = lastRects;
+	surface->avcLastNumRects = lastRects ? meta->numRegionRects : 0;
+
+	surface->avcYuvLeft = left;
+	surface->avcYuvTop = top;
+	surface->avcYuvRight = right;
+	surface->avcYuvBottom = bottom;
+	surface->avcYuvWidth = w;
+	surface->avcYuvHeight = h;
+	surface->avcYuvStride[0] = w;
+	surface->avcYuvStride[1] = cw;
+	surface->avcYuvStride[2] = cw;
+	surface->avcYuvValid = TRUE;
+	return TRUE;
+}
+
+static void gdi_avc_yuv_flush_locked(rdpGdi* gdi, RdpgfxClientContext* context, gdiGfxSurface* surface)
+{
+	WINPR_ASSERT(gdi);
+	WINPR_ASSERT(context);
+	WINPR_ASSERT(surface);
+
+	if (!surface->avcYuvValid)
+		return;
+
+	if (surface->avcLastData && (surface->avcLastSize > 0) && surface->avcLastRects &&
+	    (surface->avcLastNumRects > 0) && surface->h264)
+	{
+		(void)avc420_decompress(surface->h264, surface->avcLastData, surface->avcLastSize,
+		                        surface->data, surface->format, surface->scanline,
+		                        surface->width, surface->height,
+		                        (const RECTANGLE_16*)surface->avcLastRects,
+		                        surface->avcLastNumRects);
+	}
+
+	RECTANGLE_16 r = { 0 };
+	r.left = (UINT16)MIN(surface->avcYuvLeft, UINT16_MAX);
+	r.top = (UINT16)MIN(surface->avcYuvTop, UINT16_MAX);
+	r.right = (UINT16)MIN(surface->avcYuvRight, UINT16_MAX);
+	r.bottom = (UINT16)MIN(surface->avcYuvBottom, UINT16_MAX);
+	(void)region16_union_rect(&surface->invalidRegion, &surface->invalidRegion, &r);
+	if (context->UpdateSurfaceArea)
+		(void)IFCALLRESULT(CHANNEL_RC_OK, context->UpdateSurfaceArea, context,
+		                   surface->surfaceId, 1, &r);
+
+	gdi_avc_yuv_free(gdi, surface);
+}
+#endif
+
+static BOOL gdi_avc_yuv_capture(rdpGdi* gdi, gdiGfxSurface* surface,
+                                const RDPGFX_H264_METABLOCK* meta,
+                                const RDPGFX_AVC420_BITMAP_STREAM* bs)
+{
+	EnterCriticalSection(&gdi->avcYuvLock);
+	const BOOL rc = gdi_avc_yuv_capture_locked(gdi, surface, meta, bs);
+	LeaveCriticalSection(&gdi->avcYuvLock);
+	return rc;
+}
+
+static void gdi_avc_yuv_flush(rdpGdi* gdi, RdpgfxClientContext* context, gdiGfxSurface* surface)
+{
+	EnterCriticalSection(&gdi->avcYuvLock);
+	gdi_avc_yuv_flush_locked(gdi, context, surface);
+	LeaveCriticalSection(&gdi->avcYuvLock);
+}
