+/* LanRDP: append r minus cut (up to four pieces). */
+static void subtract_rect(const SDL_Rect& r, const SDL_Rect& cut, std::vector<SDL_Rect>& out)
+{
+	if ((r.x >= cut.x + cut.w) || (cut.x >= r.x + r.w) || (r.y >= cut.y + cut.h) ||
+	    (cut.y >= r.y + r.h))
+	{
+		out.push_back(r);
+		return;
+	}
+
+	const int rBottom = r.y + r.h;
+	const int cutBottom = cut.y + cut.h;
+	if (r.y < cut.y)
+		out.push_back({ r.x, r.y, r.w, cut.y - r.y });
+	if (rBottom > cutBottom)
+		out.push_back({ r.x, cutBottom, r.w, rBottom - cutBottom });
+
+	const int top = (r.y > cut.y) ? r.y : cut.y;
+	const int bottom = (rBottom < cutBottom) ? rBottom : cutBottom;
+	if (bottom <= top)
+		return;
+
+	if (r.x < cut.x)
+		out.push_back({ r.x, top, cut.x - r.x, bottom - top });
+	const int rRight = r.x + r.w;
+	const int cutRight = cut.x + cut.w;
+	if (rRight > cutRight)
+		out.push_back({ cutRight, top, rRight - cutRight, bottom - top });
+}
