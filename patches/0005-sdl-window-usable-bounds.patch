+void SdlWindow::fitToUsableBounds()
+{
+#if defined(__APPLE__)
+	if (!_window)
+		return;
+
+	/* LanRDP: fit a windowed session into the display's usable area so it
+	 * never covers the Dock or menu bar. */
+	const auto display = SDL_GetDisplayForWindow(_window);
+	SDL_Rect usable = {};
+	if (!SDL_GetDisplayUsableBounds(display, &usable))
+		return;
+
+	int top = 0;
+	int left = 0;
+	int bottom = 0;
+	int right = 0;
+	if (!SDL_GetWindowBordersSize(_window, &top, &left, &bottom, &right))
+	{
+		top = 0;
+		left = 0;
+		bottom = 0;
+		right = 0;
+	}
+
+	const int w = usable.w - left - right;
+	const int h = usable.h - top - bottom;
+	if ((w <= 0) || (h <= 0))
+		return;
+
+	std::ignore = SDL_SetWindowSize(_window, w, h);
+	std::ignore = SDL_SetWindowPosition(_window, usable.x + left, usable.y + top);
+	std::ignore = SDL_SyncWindow(_window);
+#endif
+}
